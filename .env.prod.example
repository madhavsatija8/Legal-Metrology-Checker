# Copy this to .env.prod and fill in real values:
#   cp .env.prod.example .env.prod
# Never commit .env.prod — it's already covered by .gitignore.

# Two subdomains pointed (A/AAAA records) at this server's IP before you
# start the stack — Caddy will fail to issue certificates otherwise.
#   app.yourdomain.gov.in  -> the compliance dashboard
#   api.yourdomain.gov.in  -> the FastAPI backend
DOMAIN_APP=app.yourdomain.gov.in
DOMAIN_API=api.yourdomain.gov.in

# Contact address Let's Encrypt uses for certificate expiry/revocation notices.
ACME_EMAIL=ops@yourdomain.gov.in

# Generate with: openssl rand -hex 32
# Rotating this invalidates every issued JWT (everyone gets logged out).
JWT_SECRET_KEY=

# Generate with: openssl rand -hex 20
POSTGRES_PASSWORD=
